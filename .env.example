# ===========================================
# Storige Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# IMPORTANT: Change all passwords and secrets in production!

# ===========================================
# Database Configuration (MariaDB 11.2)
# ===========================================
MYSQL_ROOT_PASSWORD=your-secure-root-password-here
DATABASE_USER=storige
DATABASE_PASSWORD=your-secure-database-password-here
DATABASE_NAME=storige
DATABASE_HOST=mariadb
DATABASE_PORT=3306

# ===========================================
# API Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# API Server
NODE_ENV=production
API_PORT=4000

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ===========================================
# Worker Configuration
# ===========================================
WORKER_PORT=4001
MAX_RETRY_ATTEMPTS=3
# ⚠️ api·worker 공용. worker 는 PDF 검증·변환·합성에, api 는 `GET /files/:id/thumbnail`
#    래스터화에 쓴다(2026-07-30 부터 — 그전까지 api 이미지에 gs 가 없어 상시 실패했다).
#    compose 가 두 서비스 모두 이 변수를 참조하므로 값을 바꾸면 양쪽에 함께 적용된다.
GHOSTSCRIPT_PATH=/usr/bin/gs

# Worker -> API callback authentication
# Must match one of the API_KEYS values
WORKER_API_KEY=your-api-key-1
API_BASE_URL=http://localhost:4000/api

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# Storage Configuration
# ===========================================
STORAGE_PATH=/app/storage
STORAGE_BASE_URL=http://localhost/storage

# -------------------------------------------
# S4 산출물 서명 URL (2026-08-28 도입 / D5 cutover 2026-09-11 로 유일 경로)
# -------------------------------------------
# 무인증 /storage/outputs/ 는 410 Gone 이다. 산출물 회수는
# `GET /api/worker-jobs/external/:id/output-url` 발급 → 반환 URL GET 이 유일 경로.
#
# ⚠️ OUTPUT_SIGN_SECRET 은 `docker/nginx/secure-link-secret.conf` 의 값과 **반드시 동일**해야 한다
#    (nginx 가 검증, api 가 발급 — 불일치 시 발급은 되는데 전건 403). 미설정이면 발급 API 가
#    503 SIGNED_URL_NOT_CONFIGURED 로 fail-closed 라서 **신규 환경은 산출물 회수가 전건 실패**한다.
#    생성: openssl rand -hex 32   / 템플릿: docker/nginx/secure-link-secret.conf.example
OUTPUT_SIGN_SECRET=
# 서명 URL 유효시간(초). 코드 하한 30, 미설정 기본 300
OUTPUT_URL_TTL_SEC=300
# siteId 가 NULL 인 레거시 잡에 한해 발급을 허용할 site id 목록(콤마 구분). 비우면 NULL 잡 발급 거부
OUTPUT_URL_NULL_JOB_SITE_ALLOWLIST=

# ===========================================
# Nginx Configuration
# ===========================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ===========================================
# API Key Authentication (for bookmoa integration)
# ===========================================
# Comma-separated list of valid API keys
# Generate secure keys: openssl rand -hex 32
API_KEYS=your-api-key-1,your-api-key-2

# ===========================================
# bookmoa Integration
# ===========================================
# bookmoa DB connection (read-only, for member validation)
# BOOKMOA_DB_HOST=localhost
# BOOKMOA_DB_PORT=3306
# BOOKMOA_DB_USER=bookmoa_reader
# BOOKMOA_DB_PASSWORD=your-secure-password
# BOOKMOA_DB_NAME=bookmoa

# ===========================================
# Production URLs (Change for production)
# ===========================================
# VITE_API_BASE_URL=https://yourdomain.com/api
# STORAGE_BASE_URL=https://yourdomain.com/storage
# CORS_ORIGIN=https://yourdomain.com

# ===========================================
# Feature Flags (참고용 주석 — 이 섹션에는 대입문을 두지 않는다)
# ===========================================
# 이 파일은 scripts/dev-start.sh 가 .env 로 복사하므로, 아래는 전부 주석이다.
# 켜려면 .env 에 주석을 해제해 값을 넣는다.
# 실제 적용값은 기동 로그 한 줄로 확인한다:
#   [FLAGS] api KEY=true|false ...   /   [FLAGS] worker KEY=true|false ...
# docker-compose.yml 이 `${VAR:-false}` 형태로 받는 플래그는 .env 에서 빠지면 false 로 동작한다.
#
# 파싱 규칙(플래그마다 다름):
#   (A) 앞뒤 공백 제거 + 대소문자 무시, `true` 또는 `1` 이면 ON
#   (B) 소문자 변환 후 정확히 `true` 일 때만 ON (`1`, 앞뒤 공백 포함 값은 OFF)
#   (C) 정확히 적힌 값과 일치할 때만 해당 동작(대소문자 구분, 공백 제거 없음)
#
# --- api + worker 공통 ---
# 배경제거(컷아웃) 서버 처리. 규칙 (A), 기본 false. api 와 worker 에 같은 값을 넣는다.
# CUTOUT_ENABLED=false
# 스프레드 스냅샷 크기 불일치 시 차단(HARD). 규칙 (C): 정확히 `true` 일 때만 ON, 기본 false(경고만).
# SPREAD_SNAPSHOT_HARD_FAIL=false
#
# --- api ---
# Bull 큐 적체/실패 감시. 규칙 (C): 정확히 `false` 일 때만 OFF, 기본 true.
# QUEUE_MONITOR_ENABLED=true
# 미참조 업로드 파일 정리 cron. 규칙 (C): 정확히 `false` 일 때만 OFF, 기본 true.
# FILE_ORPHAN_ENABLED=true
# 위 정리의 dry-run(삭제 대신 로그). 규칙 (C): 정확히 `0` 일 때만 OFF, 기본 dry-run ON.
#   `false` 등 다른 값은 dry-run 유지. 관리자 보존정책의 dry-run 과 OR 로 합쳐진다.
# FILE_ORPHAN_DRY_RUN=1
# 파일 보존정책 기본값(관리자 설정이 저장돼 있으면 그 값이 우선).
#   ENABLED: 정확히 `false` 일 때만 OFF, 기본 true. DRY_RUN: 정확히 `1` 일 때만 ON, 기본 false.
# FILE_RETENTION_ENABLED=true
# FILE_RETENTION_DRY_RUN=0
# 버전 썸네일 정리의 dry-run. 규칙 (C): 정확히 `1` 일 때만 ON, 기본 false.
# THUMBNAIL_CLEANUP_DRY_RUN=0
#
# --- worker ---
# 아래 6개는 전부 규칙 (B), 기본 false.
# 경량(스트리밍) PDF 검증 경로.
# WORKER_LIGHTWEIGHT_VALIDATION=false
# 변환·합성·렌더 경량(qpdf) 경로.
# WORKER_LIGHTWEIGHT_SYNTHESIS=false
# TrimBox 재단 기하 검증(경고 전용, 템플릿셋 opt-in 과 이중 게이트).
# WORKER_CROP_MARK_VALIDATION=false
# 실행기가 배선된 fixMethod 에만 autoFixable 부여.
# WORKER_WIRED_FIXABLE_GATING=false
# 최종 인쇄 산출 정규화(CMYK + OutputIntent). 실패 시 원본 유지.
# PRINT_NORMALIZE=false
# 정규화 시 투명도 평탄화.
# PRINT_NORMALIZE_FLATTEN=false
# 재단선 포함 PDF 의 TrimBox 기준 판형 판정·합성 크롭 정규화. **기본 ON**.
#   `false`·`0`·`off`·`no`(앞뒤 공백·대소문자 무시)일 때만 OFF(종전 MediaBox 판정).
#   docker-compose 매핑은 `${WORKER_TRIMBOX_SIZE_CHECK:-true}` 이다(`:-false` 로 바꾸지 말 것).
# WORKER_TRIMBOX_SIZE_CHECK=true

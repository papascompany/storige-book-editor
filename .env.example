# ===========================================
# Storige Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# IMPORTANT: Change all passwords and secrets in production!

# ===========================================
# Database Configuration (MariaDB 11.2)
# ===========================================
MYSQL_ROOT_PASSWORD=your-secure-root-password-here
DATABASE_USER=storige
DATABASE_PASSWORD=your-secure-database-password-here
DATABASE_NAME=storige
DATABASE_HOST=mariadb
DATABASE_PORT=3306

# ===========================================
# API Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# API Server
NODE_ENV=production
API_PORT=4000

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ===========================================
# Worker Configuration
# ===========================================
WORKER_PORT=4001
MAX_RETRY_ATTEMPTS=3
# ⚠️ api·worker 공용. worker 는 PDF 검증·변환·합성에, api 는 `GET /files/:id/thumbnail`
#    래스터화에 쓴다(2026-07-30 부터 — 그전까지 api 이미지에 gs 가 없어 상시 실패했다).
#    compose 가 두 서비스 모두 이 변수를 참조하므로 값을 바꾸면 양쪽에 함께 적용된다.
GHOSTSCRIPT_PATH=/usr/bin/gs

# Worker -> API callback authentication
# Must match one of the API_KEYS values
WORKER_API_KEY=your-api-key-1
API_BASE_URL=http://localhost:4000/api

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# Storage Configuration
# ===========================================
STORAGE_PATH=/app/storage
STORAGE_BASE_URL=http://localhost/storage

# -------------------------------------------
# S4 산출물 서명 URL (2026-08-28 도입 / D5 cutover 2026-09-11 로 유일 경로)
# -------------------------------------------
# 무인증 /storage/outputs/ 는 410 Gone 이다. 산출물 회수는
# `GET /api/worker-jobs/external/:id/output-url` 발급 → 반환 URL GET 이 유일 경로.
#
# ⚠️ OUTPUT_SIGN_SECRET 은 `docker/nginx/secure-link-secret.conf` 의 값과 **반드시 동일**해야 한다
#    (nginx 가 검증, api 가 발급 — 불일치 시 발급은 되는데 전건 403). 미설정이면 발급 API 가
#    503 SIGNED_URL_NOT_CONFIGURED 로 fail-closed 라서 **신규 환경은 산출물 회수가 전건 실패**한다.
#    생성: openssl rand -hex 32   / 템플릿: docker/nginx/secure-link-secret.conf.example
OUTPUT_SIGN_SECRET=
# 서명 URL 유효시간(초). 코드 하한 30, 미설정 기본 300
OUTPUT_URL_TTL_SEC=300
# siteId 가 NULL 인 레거시 잡에 한해 발급을 허용할 site id 목록(콤마 구분). 비우면 NULL 잡 발급 거부
OUTPUT_URL_NULL_JOB_SITE_ALLOWLIST=

# ===========================================
# Nginx Configuration
# ===========================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ===========================================
# API Key Authentication (for bookmoa integration)
# ===========================================
# Comma-separated list of valid API keys
# Generate secure keys: openssl rand -hex 32
API_KEYS=your-api-key-1,your-api-key-2

# ===========================================
# bookmoa Integration
# ===========================================
# bookmoa DB connection (read-only, for member validation)
# BOOKMOA_DB_HOST=localhost
# BOOKMOA_DB_PORT=3306
# BOOKMOA_DB_USER=bookmoa_reader
# BOOKMOA_DB_PASSWORD=your-secure-password
# BOOKMOA_DB_NAME=bookmoa

# ===========================================
# Production URLs (Change for production)
# ===========================================
# VITE_API_BASE_URL=https://yourdomain.com/api
# STORAGE_BASE_URL=https://yourdomain.com/storage
# CORS_ORIGIN=https://yourdomain.com

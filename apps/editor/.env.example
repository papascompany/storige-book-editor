# API Configuration
VITE_API_BASE_URL=http://localhost:4000/api

# Editor Configuration
VITE_AUTO_SAVE_INTERVAL=30000
VITE_MAX_HISTORY_SIZE=50

VITE_ENABLE_IMAGE_PROCESSING=false

# AI Features (default: false)
VITE_AI_ENABLED=false
# P1 캘린더 (2026-10-17): 캘린더 날짜 그리드 플러그인/달력 메뉴 (default: true)
VITE_ENABLE_CALENDAR=true
# 캘린더 디자인(스킨) 선택 절 — 'false' 면 숨김(달력 메뉴는 위 플래그가 관장) (default: true)
VITE_ENABLE_CALENDAR_SKINS=true
# P2-d 사진인화 (2026-10-19): 사진틀 fitMode/유테/촬영일/흑백 플러그인 + 사진인화 메뉴 (default: true)
VITE_ENABLE_PHOTO_PRINT=true

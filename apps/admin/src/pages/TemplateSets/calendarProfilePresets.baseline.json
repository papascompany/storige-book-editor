{
  "calendar_desk_large": {
    "version": 1,
    "kind": "calendar",
    "editorType": "calendar_desk_large",
    "pages": {
      "kind": "fixed",
      "count": 26,
      "step": 2,
      "protectedIndices": [
        0,
        25
      ],
      "labelRule": "month"
    },
    "sheet": {
      "faces": 2,
      "canvasLayout": "canvas-pair",
      "binding": "top-ring",
      "pairing": "offset-next",
      "backRotation": 0,
      "duplexFlip": "short-edge"
    },
    "calendar": {
      "layout": "desk",
      "monthCount": 12,
      "coverCanvases": 1,
      "canvasesPerMonth": 2,
      "epilogueCanvases": 1,
      "allowedRange": {
        "from": "2026-01",
        "to": "2027-12"
      },
      "weekStart": 0,
      "show": {
        "holidays": true,
        "lunar": true,
        "solarTerms": true
      },
      "dataVersion": "kr-2025-2035-v1",
      "yearPolicy": {
        "select": {
          "minDelta": 0,
          "maxDelta": 1
        }
      }
    },
    "output": {
      "mode": "single-pdf"
    }
  },

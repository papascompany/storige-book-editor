{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @storige/admin... --ignore-scripts",
  "buildCommand": "cd ../.. && pnpm --filter @storige/types build && pnpm --filter @storige/admin build",
  "outputDirectory": "dist",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs ./ ../../packages/types ../../packages/ui ../../packages/indesign-import ../../scripts ../../pnpm-lock.yaml",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://api.papascompany.co.kr/api"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}

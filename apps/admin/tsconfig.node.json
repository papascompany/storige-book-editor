{
  "compilerOptions": {
    "composite": true,
    // emitDeclarationOnly: tsc -b 가 vite.config.js 를 방출하지 못하게 한다(.d.ts 만 방출).
    // vite.config.js 가 생기면 Vite 설정 해석 우선순위(.js > .ts)로 stale vite.config.js 가
    // vite.config.ts 를 shadow → 로컬 빌드/설정 편집이 조용히 무효화된다.
    // editor 는 f2680ec 에서 이미 고쳤고, admin 에는 누락돼 실제 stale .js 가 남아 있었다(2026-07-27 제거).
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}

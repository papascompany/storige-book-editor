# apps/worker/.env.development.example — 로컬 개발용 워커 환경(2026-10-17). 복사해서 .env.development 로 쓴다(gitignored).
# api 의 .env.development 와 같은 DB·Redis·storage 를 바라봐야 한다. 값은 로컬 전용 — 운영 값 금지.
NODE_ENV=development
PORT=4001

# api 와 같은 로컬 MariaDB (예: docker run mariadb:11.2 -p 127.0.0.1:3306:3306)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=storige

# Redis (brew services start redis 또는 docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# api 의 STORAGE_PATH 와 같은 디렉터리를 절대 경로로 (api 는 apps/api 기준 상대 경로 ./storage 를 쓴다)
STORAGE_PATH=/absolute/path/to/storige/apps/api/storage

# macOS Homebrew: /opt/homebrew/bin/gs · Linux: /usr/bin/gs
GHOSTSCRIPT_PATH=/opt/homebrew/bin/gs
RETRY_DELAY_MS=1000

# 잡 상태 보고·파일 다운로드 — api 의 WORKER_API_KEY 와 같고, 로컬 사이트의 worker_auth_code 와도 같아야 한다
API_BASE_URL=http://localhost:4000/api
WORKER_API_KEY=

# pretty 로그를 끄고 JSON 으로 보려면(파이프·수집용)
# LOG_PRETTY=false

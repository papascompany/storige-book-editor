# Application
NODE_ENV=development
PORT=4001

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=storige

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
STORAGE_PATH=./storage

# Ghostscript
GHOSTSCRIPT_PATH=/usr/bin/gs

# Worker Settings
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=60000

# Feature Flags (참고용 주석 — 대입문 없음)
# worker 단독 로컬 실행(src/main.ts 가 apps/worker/.env 를 읽음) 기준. compose 를 거치지
# 않으므로 미설정이면 아래 코드 기본값(전부 false)으로 동작한다.
# 실제 적용값은 기동 로그 `[FLAGS] worker KEY=true|false ...` 한 줄로 확인한다.
#
# 파싱 규칙(플래그마다 다름):
#   (A) 앞뒤 공백 제거 + 대소문자 무시, `true` 또는 `1` 이면 ON
#   (B) 소문자 변환 후 정확히 `true` 일 때만 ON (`1`, 앞뒤 공백 포함 값은 OFF)
#   (C) 정확히 `true` 일 때만 ON (대소문자 구분)
#
# 배경제거(컷아웃) 처리. 규칙 (A). api 와 같은 값이어야 한다.
# CUTOUT_ENABLED=false
# 경량(스트리밍) PDF 검증 경로. 규칙 (B).
# WORKER_LIGHTWEIGHT_VALIDATION=false
# 변환·합성·렌더 경량(qpdf) 경로. 규칙 (B).
# WORKER_LIGHTWEIGHT_SYNTHESIS=false
# TrimBox 재단 기하 검증(경고 전용). 규칙 (B).
# WORKER_CROP_MARK_VALIDATION=false
# 실행기가 배선된 fixMethod 에만 autoFixable 부여. 규칙 (B).
# WORKER_WIRED_FIXABLE_GATING=false
# 최종 인쇄 산출 정규화. 규칙 (B).
# PRINT_NORMALIZE=false
# 정규화 시 투명도 평탄화. 규칙 (B).
# PRINT_NORMALIZE_FLATTEN=false
# 재단선 포함 PDF 의 TrimBox 기준 판형 판정·합성 크롭 정규화. 기본 ON.
#   `false`·`0`·`off`·`no`(앞뒤 공백·대소문자 무시)일 때만 OFF.
# WORKER_TRIMBOX_SIZE_CHECK=true
# 스프레드 스냅샷 크기 불일치 시 잡 실패 처리. 규칙 (C).
# SPREAD_SNAPSHOT_HARD_FAIL=false

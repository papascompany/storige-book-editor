# S4 산출물 서명 시크릿 (2026-08-28) — 이 파일을 같은 디렉터리의
# secure-link-secret.conf 로 복사하고 값을 강한 난수(32바이트+)로 교체하라.
#   openssl rand -hex 32
# ⚠️ 값은 VPS ~/storige/.env 의 OUTPUT_SIGN_SECRET 과 **반드시 동일**해야 한다
#    (API 가 서명하고 nginx 가 검증하는 공유 시크릿).
# ⚠️ 실값 파일(secure-link-secret.conf)은 gitignored — 절대 커밋 금지(PUBLIC 레포).
set $outputs_sign_secret "CHANGE_ME_openssl_rand_hex_32";
